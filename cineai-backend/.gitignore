# =============================================================
#  Cine AI Backend — .gitignore
# =============================================================

# 🔐 NEVER commit secrets
.env
.env.*
*.env
secrets.json

# 🐍 Virtual environments
venv/
.venv/
ENV/
env/

# 🐍 Python compiled artifacts
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
*.egg-info/
dist/
build/

# 🐳 Docker
*.log

# 💻 OS/Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
