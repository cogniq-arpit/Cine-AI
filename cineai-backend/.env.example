# 🎬 Cine AI Backend Environment Config Template
# Copy this file to '.env' and fill in your actual values.

# Security JWT Signature Keys
JWT_SECRET=super_secure_sha256_access_token_signing_key_production_cineai
JWT_REFRESH_SECRET=super_secure_sha256_refresh_token_signing_key_production_cineai

# Database Connection (Replace with your actual PostgreSQL address or local container)
# Format: postgresql://[USER]:[PASSWORD]@[HOST]:[PORT]/[DATABASE]
# Example: postgresql://postgres:postgres@localhost:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# External Cinematic API Keys
# Gemini API Key: Get yours at https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyD_your_valid_google_gemini_api_key

# TMDB API Configuration: Get your keys at https://developer.themoviedb.org/
TMDB_API_KEY=your_tmdb_api_key
TMDB_ACCESS_TOKEN=your_tmdb_read_access_token
